# ═══ Intelligent Housekeeper 环境变量配置 ═══
# 复制此文件为 .env 并填入实际值后即可使用 (.env 已被 .gitignore 排除, 不会上传)

# ── 数据库 (默认SQLite) ──
# DATABASE_URL=sqlite:///./data/housekeeper.db

# ── JWT密钥 (生产环境请改为随机字符串) ──
JWT_SECRET=change-this-to-a-random-secret-key

# ═══ 模型配置 (必需) ═══
# 支持任何 OpenAI 兼容 API(阿里云 DashScope / DeepSeek / OpenAI 等)

# 主体模型 — 用于对话、工具调用
MAIN_MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MAIN_MODEL_API_KEY=sk-your-api-key-here
MAIN_MODEL_NAME=qwen3.6-flash
MAIN_MODEL_TEMPERATURE=0.7
MAIN_MODEL_MAX_TOKENS=8192
MAIN_MODEL_THINKING_MODE=false
MAIN_MODEL_THINKING_BUDGET=4000

# 审查模型 — 用于多智能体输出质量闸门
REVIEW_MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
REVIEW_MODEL_API_KEY=sk-your-api-key-here
REVIEW_MODEL_NAME=qwen3.6-flash
REVIEW_MODEL_TEMPERATURE=0.3
REVIEW_MODEL_THINKING_MODE=false

# ═══ 嵌入 (RAG 向量化) — provider: dashscope | local | auto ═══
# auto = 优先 DashScope text-embedding API, 失败降级本地 MiniLM, 再无则纯 BM25
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=            # 留空则回退 MAIN_MODEL_API_KEY
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH=10

# ═══ RAG 检索(通常用默认即可) ═══
# RAG_CHUNK_SIZE=700
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5
# RAG_CANDIDATE_K=30
# RAG_RETRIEVE_CACHE_TTL=60
# RAG_REWRITE=true
# RAG_SEMANTIC_THRESHOLD=0.75
# RAG_CHILD_SIZE=250
# GRAPH_ENABLED=true
# GRAPH_ENTITY_TOP_K=8
# GRAPH_BOOST=0.2
# GRAPH_BUILD_BATCH=5
# RAG_AGENT_MAX_RETRIES=2
# RAG_GRADE_HIGH=0.60
# RAG_GRADE_LOW=0.35
# RAG_AGENT_REFLECT=true

# ═══ 可选: 搜索 (Google Custom Search API) ═══
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# ═══ 可选: 天气 (华风爱科天气 https://openapi.weathercn.com) ═══
# WEATHER_API_KEY=            # 不填则天气工具不可用并返回提示

# ═══ 可选: 飞书推送 (群机器人 Webhook, 单向推送) ═══
FEISHU_WEBHOOK_URL=
FEISHU_BOT_TOKEN=

# ═══ 可选: 飞书对话触发 Agent (自建应用) ═══
# webhook 回调模式需公网 URL; 长连接模式(FEISHU_LONG_CONNECTION=true)免公网
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_LONG_CONNECTION=false

# ═══ 可选: QQ邮箱推送 ═══
QQMAIL_SMTP_HOST=smtp.qq.com
QQMAIL_SMTP_PORT=465
QQMAIL_USER=
QQMAIL_PASS=

# ═══ 推送时间 ═══
WEATHER_PUSH_TIME=07:00
NEWS_PUSH_TIME=09:00
NEWS_PUSH_CHANNELS=feishu,qqmail

# ═══ CORS (前端地址) ═══
CORS_ORIGINS=http://localhost:5173

# ═══ 桌面应用(划屏翻译/桌宠): 默认不随服务端启动, 置 true 或另跑 run_desktop.py ═══
# LAUNCH_DESKTOP_APPS=false
